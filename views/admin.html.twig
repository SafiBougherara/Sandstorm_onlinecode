{% extends "base.html.twig" %}

{% block title %}Admin Panel{% endblock %}

{% block content %}
<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1>Administration des Listings</h1>
        </div>
        <div class="col-auto">
            <span class="text-muted">Connecté en tant que : {{username}}</span>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Titre</th>
                    <th>Prix</th>
                    <th>Statut</th>
                    <th>Date de création</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for listing in listings %}
                <tr>
                    <td>{{ listing.id }}</td>
                    <td>{{ listing.title }}</td>
                    <td>{{ listing.price }} €</td>
                    <td>
                        <span class="badge {% if listing.status == 'active' %}bg-success{% elseif listing.status == 'sold' %}bg-info{% else %}bg-secondary{% endif %}">
                            {{ listing.status }}
                        </span>
                    </td>
                    <td>{{ listing.created_at|date("d/m/Y H:i") }}</td>
                    <td>
                        <form method="POST" action="/listing/{{ listing.id }}/delete" class="d-inline" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer ce listing ?');">
                            <button type="submit" class="btn btn-danger btn-sm">Supprimer</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}